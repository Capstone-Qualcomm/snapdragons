APP_URL=http://localhost:5173/snapdragons
CLUSTER_PORT=3003

# Atlassian App setup steps: see backend/jira/README.md
PORT=3001
ATLASSIAN_CLIENT_ID=your-atlassian-oauth-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-oauth-client-secret
ATLASSIAN_REDIRECT_URI=http://localhost:3001/auth/jira/callback
ATLASSIAN_SCOPES=read:jira-work read:jira-user write:jira-work offline_access

# Slack App setup steps: see backend/slack/README.md
SLACK_PORT=3002
SLACK_CLIENT_ID=your-slack-oauth-client-id
SLACK_CLIENT_SECRET=your-slack-oauth-client-secret
SLACK_REDIRECT_URI=http://localhost:3002/auth/slack/callback

# GitHub App setup steps: see backend/github/README.md
GITHUB_PORT=3004
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_REDIRECT_URI=http://localhost:3004/auth/github/callback

# Microsoft Entra app setup steps: see backend/outlook/README.md
OUTLOOK_PORT=3005
OUTLOOK_TENANT_ID=common
OUTLOOK_CLIENT_ID=your-microsoft-application-client-id
OUTLOOK_CLIENT_SECRET=your-microsoft-application-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:3005/auth/outlook/callback
OUTLOOK_SCOPES=openid profile email offline_access User.Read Mail.ReadWrite Mail.Send

# Microsoft Entra app setup steps: see backend/teams/README.md
TEAMS_PORT=3006
TEAMS_TENANT_ID=common
TEAMS_CLIENT_ID=your-microsoft-application-client-id
TEAMS_CLIENT_SECRET=your-microsoft-application-client-secret
TEAMS_REDIRECT_URI=http://localhost:3006/auth/teams/callback
TEAMS_SCOPES=openid profile email offline_access User.Read Chat.Read

# Model on GCP, for the Assistant's live job and Today list ranking (backend/cluster/llm.ts).
# GCP_AI_KEY is the service account's JSON on one line: base64 < service-account.json | tr -d '\n'
GCP_AI_ENDPOINT=https://aiplatform.googleapis.com/v1/projects/cai-cs-nplus1-students-ba13/locations/global/endpoints/openapi
GCP_AI_KEY=
GCP_AI_MODEL=deepseek-ai/deepseek-v4.1-flash-maas
# Model Armor template that checks each prompt and reply. Leave it unset to skip the checks locally. The service account needs the Model Armor User role.
GCP_AI_ARMOR=https://modelarmor.us-central1.rep.googleapis.com/v1/projects/cai-cs-nplus1-students-ba13/locations/us-central1/templates/snapdragons-capstone

# Real Uno Q boards instead of simulated nodes: the board names to look for first (backend/cluster/README.md)
# CLUSTER_BOARDS=q-sanyam

# Boards really load each source in a refresh, as the browser that asked (backend/cluster/README.md, Refresh fetching)
# CLUSTER_FETCH_SOURCES=1
