# Create a Jira OAuth 2.0 (3LO) integration in the Atlassian Developer Console.
JIRA_CLIENT_ID=your-atlassian-client-id
JIRA_CLIENT_SECRET=your-atlassian-client-secret
JIRA_REDIRECT_URI=http://localhost:5173/auth/jira/callback

# Generate independent random secrets for sessions and encrypted Jira tokens.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
JIRA_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# The store must live on persistent storage in production.
JIRA_CONNECTION_STORE=backend/integrations/jira/.data/jira-connections.json
PORT=3001
HOST=127.0.0.1
