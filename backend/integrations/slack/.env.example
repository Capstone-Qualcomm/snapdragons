# Create a Slack app at https://api.slack.com/apps and add these user token scopes:
# search:read, im:read, im:history, users:read
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# Slack only accepts HTTPS redirect URLs, so local development needs an HTTPS URL (see README).
SLACK_REDIRECT_URI=https://localhost:5173/auth/slack/callback

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SLACK_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
SLACK_CONNECTION_STORE=backend/integrations/slack/.data/slack-connections.json
