# The live site's routing: the same as the proxy in frontend/vite.config.js, on one public address.
# tests/deploy.test.ts fails when the frontend calls a path that no rule here sends to a backend.
:80 {
	redir / /snapdragons/

	@cluster path /snapdragons/api/cluster/* /snapdragons/api/assistant/* /snapdragons/api/today/*
	handle @cluster {
		uri strip_prefix /snapdragons
		reverse_proxy localhost:3003
	}
	@slack path /snapdragons/api/slack/* /snapdragons/auth/slack/*
	handle @slack {
		uri strip_prefix /snapdragons
		reverse_proxy localhost:3002
	}
	@github path /snapdragons/api/github/* /snapdragons/auth/github/*
	handle @github {
		uri strip_prefix /snapdragons
		reverse_proxy localhost:3004
	}
	@outlook path /snapdragons/api/outlook/* /snapdragons/auth/outlook/*
	handle @outlook {
		uri strip_prefix /snapdragons
		reverse_proxy localhost:3005
	}
	@teams path /snapdragons/api/teams/* /snapdragons/auth/teams/*
	handle @teams {
		uri strip_prefix /snapdragons
		reverse_proxy localhost:3006
	}
	@jira path /snapdragons/api/jira/* /snapdragons/auth/jira/*
	handle @jira {
		uri strip_prefix /snapdragons
		reverse_proxy localhost:3001
	}
	# The app with sample work for recording demos: its files stay on orsat, outside git (deploy/README.md).
	# Cluster and Assistant reach the real boards.
	@demoWebsiteCluster path /demo-website/api/cluster/* /demo-website/api/assistant/*
	handle @demoWebsiteCluster {
		uri strip_prefix /demo-website
		reverse_proxy localhost:3003
	}
	redir /demo-website /demo-website/
	handle_path /demo-website/* {
		root * /srv/demo/website
		try_files {path} /index.html
		file_server
	}
	# The demo page for our mentor: video files stay on orsat, outside git (deploy/README.md).
	redir /demo /demo/
	handle_path /demo/* {
		root * /srv/demo
		file_server
	}
	handle_path /snapdragons/* {
		root * /app/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
